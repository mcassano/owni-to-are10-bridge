[Unit]
Description=Owni shot logger (BLE central), forwards shots to the are10 emulator
After=bluetooth.service
Requires=bluetooth.service

[Service]
WorkingDirectory=/opt/owni-logger
# The TP-Link UB500 Plus USB adapter, by address (hciN can swap between boots).
Environment=ADAPTER=AC:A7:F1:BD:45:FE
ExecStart=/opt/owni-logger/.venv/bin/python owni_logger.py --adapter ${ADAPTER}
Restart=on-failure
RestartSec=5
RuntimeDirectory=owni-logger

[Install]
WantedBy=multi-user.target
